#include <vector>
#include <algorithm>
#include <utility>

using namespace std;

// Scales each column to a 0-1 range using min-max normalization
vector<vector<double>> column_normalize(const vector<vector<double>>& data) {
    if (data.empty() || data[0].empty()) return {};

    size_t num_rows = data.size();
    size_t num_cols = data[0].size();

    vector<double> col_mins(num_cols), col_maxs(num_cols);
    for (size_t c = 0; c < num_cols; ++c) {
        col_mins[c] = data[0][c];
        col_maxs[c] = data[0][c];
        for (size_t r = 1; r < num_rows; ++r) {
            col_mins[c] = min(col_mins[c], data[r][c]);
            col_maxs[c] = max(col_maxs[c], data[r][c]);
        }
    }

    vector<vector<double>> normalized(num_rows, vector<double>(num_cols));
    for (size_t r = 0; r < num_rows; ++r) {
        for (size_t c = 0; c < num_cols; ++c) {
            double col_min = col_mins[c];
            double col_max = col_maxs[c];
            if (col_max == col_min) {
                normalized[r][c] = 0.0;
            } else {
                normalized[r][c] = (data[r][c] - col_min) / (col_max - col_min);
            }
        }
    }

    return normalized;
}

// Ranks the values within each row (ties share the average rank)
vector<vector<double>> row_rank(const vector<vector<double>>& data, bool ascending = true) {
    vector<vector<double>> ranked_data;

    for (const auto& row : data) {
        vector<pair<size_t, double>> indexed;
        for (size_t i = 0; i < row.size(); ++i) indexed.push_back({i, row[i]});

        sort(indexed.begin(), indexed.end(), [ascending](const pair<size_t, double>& a, const pair<size_t, double>& b) {
            return ascending ? a.second < b.second : a.second > b.second;
        });

        vector<double> ranks(row.size(), 0.0);
        size_t i = 0;
        while (i < indexed.size()) {
            size_t j = i;
            while (j + 1 < indexed.size() && indexed[j + 1].second == indexed[i].second) {
                ++j;
            }
            double avg_rank = (i + j) / 2.0 + 1;
            for (size_t k = i; k <= j; ++k) {
                ranks[indexed[k].first] = avg_rank;
            }
            i = j + 1;
        }

        ranked_data.push_back(ranks);
    }

    return ranked_data;
}

// Ranks the values within each column (ties share the average rank)
vector<vector<double>> column_rank(const vector<vector<double>>& data, bool ascending = true) {
    if (data.empty() || data[0].empty()) return {};

    size_t num_rows = data.size();
    size_t num_cols = data[0].size();
    vector<vector<double>> ranks(num_rows, vector<double>(num_cols, 0.0));

    for (size_t c = 0; c < num_cols; ++c) {
        vector<pair<size_t, double>> column_values;
        for (size_t r = 0; r < num_rows; ++r) column_values.push_back({r, data[r][c]});

        sort(column_values.begin(), column_values.end(), [ascending](const pair<size_t, double>& a, const pair<size_t, double>& b) {
            return ascending ? a.second < b.second : a.second > b.second;
        });

        size_t i = 0;
        while (i < column_values.size()) {
            size_t j = i;
            while (j + 1 < column_values.size() && column_values[j + 1].second == column_values[i].second) {
                ++j;
            }
            double avg_rank = (i + j) / 2.0 + 1;
            for (size_t k = i; k <= j; ++k) {
                ranks[column_values[k].first][c] = avg_rank;
            }
            i = j + 1;
        }
    }

    return ranks;
}

// Flips the dataframe so rows become columns and columns become rows
vector<vector<double>> transpose(const vector<vector<double>>& data) {
    if (data.empty()) return {};

    size_t num_rows = data.size();
    size_t num_cols = data[0].size();

    vector<vector<double>> transposed(num_cols, vector<double>(num_rows));
    for (size_t c = 0; c < num_cols; ++c) {
        for (size_t r = 0; r < num_rows; ++r) {
            transposed[c][r] = data[r][c];
        }
    }

    return transposed;
}

// Returns the diagonal elements of a square matrix
vector<double> diagonal(const vector<vector<double>>& data) {
    if (data.empty()) return {};

    size_t num_rows = data.size();
    size_t num_cols = data[0].size();
    size_t limit = min(num_rows, num_cols);

    vector<double> diag;
    for (size_t i = 0; i < limit; ++i) {
        diag.push_back(data[i][i]);
    }

    return diag;
}
