# Scales each column to a 0-1 range using min-max normalization
def column_normalize(data):
    if not data or not data[0]:
        return []

    num_rows = len(data)
    num_cols = len(data[0])

    col_mins = [min(data[r][c] for r in range(num_rows)) for c in range(num_cols)]
    col_maxs = [max(data[r][c] for r in range(num_rows)) for c in range(num_cols)]

    normalized = []
    for row in data:
        new_row = []
        for c in range(num_cols):
            col_min = col_mins[c]
            col_max = col_maxs[c]
            if col_max == col_min:
                new_row.append(0.0)
            else:
                new_row.append((row[c] - col_min) / (col_max - col_min))
        normalized.append(new_row)

    return normalized


# Ranks the values within each row (ties share the average rank)
def row_rank(data, ascending=True):
    ranked_data = []

    for row in data:
        indexed = list(enumerate(row))
        indexed.sort(key=lambda pair: pair[1], reverse=not ascending)

        ranks = [0] * len(row)
        i = 0
        while i < len(indexed):
            j = i
            while j + 1 < len(indexed) and indexed[j + 1][1] == indexed[i][1]:
                j += 1
            avg_rank = (i + j) / 2 + 1
            for k in range(i, j + 1):
                original_index = indexed[k][0]
                ranks[original_index] = avg_rank
            i = j + 1

        ranked_data.append(ranks)

    return ranked_data


# Ranks the values within each column (ties share the average rank)
def column_rank(data, ascending=True):
    if not data or not data[0]:
        return []

    num_rows = len(data)
    num_cols = len(data[0])
    ranks = [[0] * num_cols for _ in range(num_rows)]

    for c in range(num_cols):
        column_values = [(r, data[r][c]) for r in range(num_rows)]
        column_values.sort(key=lambda pair: pair[1], reverse=not ascending)

        i = 0
        while i < len(column_values):
            j = i
            while j + 1 < len(column_values) and column_values[j + 1][1] == column_values[i][1]:
                j += 1
            avg_rank = (i + j) / 2 + 1
            for k in range(i, j + 1):
                original_row = column_values[k][0]
                ranks[original_row][c] = avg_rank
            i = j + 1

    return ranks


# Flips the dataframe so rows become columns and columns become rows
def transpose(data):
    if not data:
        return []

    num_rows = len(data)
    num_cols = len(data[0])

    transposed = []
    for c in range(num_cols):
        new_row = [data[r][c] for r in range(num_rows)]
        transposed.append(new_row)

    return transposed


# Returns the diagonal elements of a square matrix
def diagonal(data):
    if not data:
        return []

    num_rows = len(data)
    num_cols = len(data[0])
    limit = min(num_rows, num_cols)

    return [data[i][i] for i in range(limit)]
